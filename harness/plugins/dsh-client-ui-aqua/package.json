{
  "name": "dsh-client-ui-aqua",
  "description": "ORION Aqua UI plugin for DeepSeek Harness Alpha: optional glass material, wallpaper, motion, and a one-click return to the native interface.",
  "version": "1.3.1-orion-alpha.4",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WYH66666666/DSH-Transparent-UI-Plugin.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.3-alpha.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.3-alpha.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.3-alpha.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.3-alpha.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.3-alpha.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.3-alpha.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.3-alpha.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.3-alpha.2 || 0.2.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
