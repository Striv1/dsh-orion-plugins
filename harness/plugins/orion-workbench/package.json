{
  "name": "dsh-orion-workbench",
  "version": "1.0.0-rc.10",
  "private": true,
  "description": "ORION 本体工程、正式资产、模板、证据问答和分析工作台。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./skills": "./lib/skills.js",
    "./runtime-manager": "./lib/runtime-manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "runtime.js",
    "runtime",
    "client.js",
    "lib",
    "skills",
    "assets",
    "glass.css",
    "workbench-assets.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
